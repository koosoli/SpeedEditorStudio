{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Speed Editor Studio",
  "version": "0.1.0",
  "identifier": "io.github.openspeededitor.studio",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Speed Editor Studio",
        "width": 1360,
        "height": 860,
        "minWidth": 860,
        "minHeight": 560,
        "dragDropEnabled": false,
        "visible": false,
        "backgroundColor": "#121417"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; script-src 'self'"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico", "icons/icon.png"]
  }
}
